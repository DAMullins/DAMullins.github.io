---
import config from "@/config";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
---

<Layout title={`Resume | ${config.site.title}`}>
  <Header />
  
  <main id="main-content">
    <section class="mx-auto mt-8 mb-12 w-full max-w-5xl px-4">
      <div class="mb-6 flex items-center justify-between">
        <h1 class="text-2xl font-semibold text-skin-accent">Resume</h1>
        <a 
          href="/resume.pdf" 
          download 
          class="hover:text-skin-accent underline decoration-dashed underline-offset-4"
        >
          Download PDF
        </a>
      </div>
      
      <iframe 
        src="/resume.pdf" 
        class="h-[80vh] w-full rounded-md border border-skin-line shadow-sm"
        title="Resume"
      >
      </iframe>
    </section>
  </main>

  <Footer />
</Layout>